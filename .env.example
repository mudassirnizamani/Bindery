# Google API Keys
# Copy this file to .env and add your actual keys

# Gemini API Key (for book_formatter.py)
# Get your key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# Google Cloud Vision API Credentials (for google_vision_extractor.py)
# Path to your service account JSON key file
# Get from: https://console.cloud.google.com
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/vision-key.json

# TypeSafe AI API Key (for page_triage.py — Jev System One model)
# Register and get your key from: https://console.typesafe.ai
# Pricing: ~$0.042 per million input tokens, output is FREE
# A full 300-page book triage costs well under $0.01
TYPESAFE_API_KEY=your-typesafe-api-key-here
